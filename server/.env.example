# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-secure-jwt-secret-min-16-chars

# Dedicated Admin & Email Credentials
# Used for default Admin user authentication and direct email dispatch (SMTP/Nodemailer)
ADMIN_EMAIL=admin@stream.net.in
ADMIN_PASSWORD=your-admin-password-here

# Optional SMTP Settings (defaults to ADMIN_EMAIL and ADMIN_PASSWORD if omitted)
SMTP_HOST=mail.stream.net.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
